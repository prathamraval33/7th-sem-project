# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/placement_portal

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq (server-side only, never exposed to frontend)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# SMTP (used to send OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Placement Portal
SMTP_USE_TLS=true


# Live web search (used for Live Career Insights)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-search-api-key

# Logging
LOG_LEVEL=INFO
